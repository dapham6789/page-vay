<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#fff;
color:#333;
line-height:1.6;
}

header{
height:90vh;
background:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),
url('https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=1600&q=80');
background-size:cover;
background-position:center;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
color:white;
}

header h1{
font-size:55px;
margin-bottom:20px;
}

header p{
font-size:22px;
margin-bottom:30px;
}

.btn{
display:inline-block;
padding:15px 35px;
background:#ff4f81;
color:white;
text-decoration:none;
border-radius:40px;
font-weight:bold;
transition:.3s;
}

.btn:hover{
background:#e43b6d;
}

section{
padding:70px 10%;
}

.title{
text-align:center;
font-size:36px;
margin-bottom:50px;
color:#ff4f81;
}

.services{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:25px;
}

.card{
padding:30px;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,.1);
text-align:center;
transition:.3s;
}

.card:hover{
transform:translateY(-8px);
}

.card h3{
margin:20px 0;
}

.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.gallery img{
width:100%;
height:340px;
object-fit:cover;
border-radius:15px;
}

.price{
background:#fff5f8;
text-align:center;
padding:60px;
border-radius:20px;
}

.price h2{
font-size:42px;
color:#ff4f81;
margin-bottom:20px;
}

.contact{
background:#ff4f81;
color:white;
text-align:center;
padding:80px 20px;
}

.contact h2{
font-size:38px;
margin-bottom:20px;
}

footer{
background:#222;
color:#bbb;
padding:20px;
text-align:center;
}

</style>

</head>

